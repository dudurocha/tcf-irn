# Required: your Anthropic API key (server-side only, never exposed to the client)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: override the default model
# Options: claude-sonnet-4-6 (recommended), claude-haiku-4-5 (cheaper), claude-opus-4-7 (best quality)
ANTHROPIC_MODEL=claude-sonnet-4-6
